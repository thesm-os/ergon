# yaml-language-server: $schema=https://goreleaser.com/static/schema.json
#
# Generated by `ergon release init`. Edit freely; ergon does not
# re-read this file at release time — goreleaser owns the actual
# release flow.
version: 2

project_name: <<.Name>>

before:
  hooks:
    - go vet ./...
    # Pre-generate shell completions and ship them in the archive,
    # rather than letting Homebrew's `generate_from_command` exec the
    # binary at install time. Cask runs that during staging — before
    # any `postflight` hook — so the quarantine xattr is still on the
    # darwin binary when it tries to run, and Apple Silicon SIGKILLs
    # it. Generating once at build time on Linux sidesteps that race.
    # Requires the binary to support `completion <shell>` (cobra's
    # default surface); delete this block if your CLI does not.
    - mkdir -p completions
<<- range .Builds>>
    - sh -c '(cd <<.Dir>> && go run <<.MainPath>> completion bash)       > completions/<<.BinaryName>>.bash'
    - sh -c '(cd <<.Dir>> && go run <<.MainPath>> completion zsh)        > completions/<<.BinaryName>>.zsh'
    - sh -c '(cd <<.Dir>> && go run <<.MainPath>> completion fish)       > completions/<<.BinaryName>>.fish'
    - sh -c '(cd <<.Dir>> && go run <<.MainPath>> completion powershell) > completions/<<.BinaryName>>.ps1'
<<- end>>

builds:
<<- range .Builds>>
  - id: <<.ID>>
    dir: <<.Dir>>
    main: <<.MainPath>>
    binary: <<.BinaryName>>
    env:
      - CGO_ENABLED=0
    mod_timestamp: '{{ .CommitTimestamp }}'
    goos:
      - linux
      - darwin
      - windows
    goarch:
      - amd64
      - arm64
    ldflags:
      - -s -w
      - -X <<.ModulePath>>/internal/version.buildVersion={{.Version}}
      - -X <<.ModulePath>>/internal/version.buildCommit={{.Commit}}
      - -X <<.ModulePath>>/internal/version.buildDate={{.CommitDate}}
<<- if $.UPX>>
    # UPX packing — runs after each build via a post-hook so the
    # filter can skip darwin (Gatekeeper rejects UPX'd binaries
    # post-notarisation) and windows_arm64 (current UPX builds are
    # unstable on that target).
    hooks:
      post:
        - cmd: sh -c 'case "{{ .Target }}" in linux_*|windows_amd64_*) exec upx --best --lzma "{{ .Path }}" ;; esac'
          output: true
<<- end>>
<<- end>>

archives:
  - id: default
    formats: ['tar.gz']
    name_template: >-
      {{ .ProjectName }}_{{ .Version }}_{{ .Os }}_{{ .Arch }}
    format_overrides:
      - goos: windows
        formats: ['zip']
    # Overriding `files` replaces goreleaser's defaults
    # (LICENSE*, README*), so list them explicitly. The
    # completions/ tree is produced by the before.hooks above.
    files:
      - LICENSE
      - README*
      - completions/*

source:
  enabled: true
  name_template: '{{ .ProjectName }}_{{ .Version }}_source'

checksum:
  name_template: checksums.txt
  algorithm: sha256

signs:
  - cmd: cosign
    signature: '${artifact}.sig'
    certificate: '${artifact}.pem'
    args:
      - sign-blob
      - '--output-signature=${signature}'
      - '--output-certificate=${certificate}'
      - '${artifact}'
      - '--yes'
    artifacts: checksum
    output: true

changelog:
  sort: asc
  use: github
  groups:
    - title: New features
      regexp: '^feat'
      order: 0
    - title: Performance
      regexp: '^perf'
      order: 1
    - title: Bug fixes
      regexp: '^fix'
      order: 2
    - title: Test rigor
      regexp: '^test'
      order: 3
    - title: Refactors
      regexp: '^refactor'
      order: 4
    - title: Other
      order: 999
  filters:
    exclude:
      - '^docs'
      - '^ci'
      - '^chore'
      - '^build'
      - '^style'
      - 'Merge pull request'
      - 'Merge branch'
<<- if .Homebrew>>

homebrew_casks:
  - name: <<.Name>>
    # CLI binaries inside the cask; goreleaser unpacks the archive
    # and links binaries[0] into Homebrew's bin/.
    binaries:
<<- range .Builds>>
      - <<.BinaryName>>
<<- end>>
    homepage: 'https://github.com/<<.HomebrewTapOwner>>/<<.Name>>'
    description: 'TODO: short project description'
    # Pre-built completions shipped inside the archive (see
    # before.hooks above). Paths are relative to staged_path; Homebrew
    # symlinks each into the right shell-completion directory and
    # renames as needed (zsh wants `_<name>` in fpath, etc.).
    # `homebrew_casks.completions` only supports bash/zsh/fish; the
    # .ps1 stays in the archive for Windows users who unpack manually.
    # For multi-binary casks this wires the FIRST build's completions;
    # adjust by hand if you want a different binary's surface.
<<- with index .Builds 0>>
    completions:
      bash: completions/<<.BinaryName>>.bash
      zsh: completions/<<.BinaryName>>.zsh
      fish: completions/<<.BinaryName>>.fish
<<- end>>
    # Without this hook, `brew install --cask` leaves
    # `com.apple.quarantine` on the binary; Gatekeeper then SIGKILLs
    # the Mach-O at exec on Apple Silicon. (Cask's
    # auto-quarantine-removal only fires for `app`/`pkg` artifact
    # types, not `binary`.) Stripping it in post-install is the
    # documented workaround until you ship Developer-ID-signed +
    # notarized binaries.
    hooks:
      post:
        install: |
          if OS.mac?
<<- range .Builds>>
            system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{staged_path}/<<.BinaryName>>"]
<<- end>>
          end
    # Tap repo lives at github.com/<<.HomebrewTapOwner>>/<<.HomebrewTapName>>.
    # Cross-repo writes need a PAT with contents:write on the tap;
    # the release workflow exposes it as $HOMEBREW_TAP_TOKEN.
    repository:
      owner: <<.HomebrewTapOwner>>
      name: <<.HomebrewTapName>>
      branch: main
      token: '{{ .Env.HOMEBREW_TAP_TOKEN }}'
    commit_author:
      name: goreleaser-bot
      email: bot@example.com  # TODO: set to your bot's email
    commit_msg_template: 'brew: bump {{ .ProjectName }} to {{ .Tag }}'
    # Skip prereleases (anything with a `-` suffix, e.g. v1.0.0-rc1).
    skip_upload: auto
<<- end>>
<<- if .Docker>>

# Docker image publishing — one multi-arch image per binary.
# The Dockerfile (referenced via `dockerfile:`) is not scaffolded;
# provide one at the repository root or adjust the path. Each
# build's image is named `<<.DockerPrefix>>/<binary>` so a
# project with multiple binaries produces independent images.
dockers_v2:
<<- range .Builds>>
  - images:
      - '<<$.DockerPrefix>>/<<.BinaryName>>'
    ids: [<<.ID>>]
    tags:
      - '{{ .Version }}'
      - latest
    platforms:
      - linux/amd64
      - linux/arm64
    dockerfile: Dockerfile
    labels:
      org.opencontainers.image.title: <<.BinaryName>>
      org.opencontainers.image.version: '{{ .Version }}'
      org.opencontainers.image.revision: '{{ .Commit }}'
      org.opencontainers.image.created: '{{ .Date }}'
      # TODO: point this at your repo's GitHub URL.
      org.opencontainers.image.source: 'https://github.com/<<$.HomebrewTapOwner>>/<<$.Name>>'
<<- end>>
<<- end>>

release:
  draft: false
  prerelease: auto
  footer: |
    **Full changelog:** {{ .ReleaseURL }}

report_sizes: true
