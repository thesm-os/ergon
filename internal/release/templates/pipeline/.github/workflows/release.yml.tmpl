# Generated by `ergon release init`. Edit freely.
name: Release
on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  packages: write
  id-token: write       # cosign keyless signing + attestation OIDC
  attestations: write   # actions/attest-build-provenance writes the SLSA attestation

jobs:
  goreleaser:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
          cache: true
      - uses: sigstore/cosign-installer@v3
<<- if .UPX>>
      - name: Install UPX
        run: sudo apt-get update && sudo apt-get install -y upx
<<- end>>
<<- if .Docker>>
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v4
      - name: Set up Buildx
        uses: docker/setup-buildx-action@v4
      - name: Login to <<.DockerRegistry>>
        uses: docker/login-action@v4
<<- if eq .DockerRegistry "ghcr.io">>
        # ghcr.io accepts the workflow's GITHUB_TOKEN — no extra
        # secrets required when publishing to your own org/user.
        with:
          registry: <<.DockerRegistry>>
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
<<- else>>
        # Non-ghcr registries need explicit credentials. Set the
        # DOCKER_USERNAME and DOCKER_TOKEN secrets in repo settings
        # (rename if your registry uses different keys).
        with:
          registry: <<.DockerRegistry>>
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_TOKEN }}
<<- end>>
<<- end>>
      - uses: goreleaser/goreleaser-action@v7
        with:
          distribution: goreleaser
          version: "~> v2"
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
<<- if .Homebrew>>
          # Cross-repo PAT with contents:write on the tap repo;
          # goreleaser's homebrew_casks block uses it to bump the
          # cask file on every non-prerelease tag.
          HOMEBREW_TAP_TOKEN: ${{ secrets.HOMEBREW_TAP_TOKEN }}
<<- end>>
      # SLSA Build L3 provenance attestation. Stored in GitHub's
      # attestation API (not attached to the release), so it works
      # even when the repo has "Immutable releases" enabled — the
      # release itself isn't modified after creation. Users verify
      # with `gh attestation verify --owner <owner> <file>` or
      # `slsa-verifier verify-artifact` against the downloaded
      # attestation bundle.
      - name: Attest build provenance
        uses: actions/attest-build-provenance@v2
        with:
          # Attest both the archives AND the raw per-target binaries
          # under dist/<id>_<goos>_<goarch>[_<variant>]/. Including the
          # binaries lets users verify the installed file directly
          # (e.g. /opt/homebrew/Caskroom/<name>/<ver>/<bin>) without
          # having to re-download the archive.
          subject-path: |
            dist/*.tar.gz
            dist/*.zip
<<- range .Builds>>
            dist/**/<<.BinaryName>>
            dist/**/<<.BinaryName>>.exe
<<- end>>
