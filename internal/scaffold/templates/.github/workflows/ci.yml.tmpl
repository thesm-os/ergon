name: CI
on:
  pull_request:
  push:
    branches: [main]
concurrency:
  group: ci-{{ "${{ github.ref }}" }}
  cancel-in-progress: true
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Install ergon
        run: go install go.thesmos.sh/ergon/cmd/ergon@latest
      - run: ergon bootstrap
      - run: ergon check
  vuln:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go install go.thesmos.sh/ergon/cmd/ergon@latest
      - run: ergon check vuln
